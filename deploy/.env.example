# Copy to /opt/relaydesk/.env on the server and fill in. Never commit the real file.
DOMAIN=relaydesk.example.com
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
RABBITMQ_USER=relay
RABBITMQ_PASSWORD=change-me

# Grafana Cloud > OpenTelemetry > OTLP endpoint and "Basic <base64(instanceId:token)>"
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
GRAFANA_OTLP_AUTH=Basic change-me
